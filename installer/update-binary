#!/sbin/sh
# OrangeFox installer - Galaxy S9 (G960F / starlte) - Exynos 9810
# Writes recovery.img to the RECOVERY partition. Works from any TWRP/OrangeFox
# (also the old Android 9 TWRP). Nothing else is touched (ROM, boot, data).
OUTFD=/proc/self/fd/$2
ZIP="$3"
ui_print() { echo "ui_print $1" > $OUTFD; echo "ui_print" > $OUTFD; }
abort() { ui_print " "; ui_print "ERROR: $1"; ui_print "The recovery was NOT changed."; cd /; rm -rf $T; exit 1; }

NAME="Galaxy S9"; MODEL="G960F"
REC=/dev/block/platform/11120000.ufs/by-name/RECOVERY
T=/tmp/ofox_installer

ui_print " "
ui_print "=============================================="
ui_print " OrangeFox R12 (zip64) - $NAME ($MODEL)"
ui_print " build @BUILD@"
ui_print "=============================================="
ui_print " "

# 1. right phone?
BL=$(getprop ro.boot.bootloader)
[ -z "$BL" ] && BL=$(getprop ro.bootloader)
case "$BL" in
  $MODEL*) ui_print "- Device: $BL (OK)" ;;
  "") abort "could not identify the device" ;;
  *) abort "this zip is for the $NAME ($MODEL); this device is $BL" ;;
esac
[ -e $REC ] || abort "RECOVERY partition not found"

# 2. extract and check the image
rm -rf $T; mkdir -p $T; cd $T || abort "no /tmp"
unzip -o "$ZIP" recovery.img recovery.img.sha256 -d $T >/dev/null 2>&1
[ -f recovery.img ] && [ -f recovery.img.sha256 ] || abort "could not extract the recovery from the zip (corrupted zip?)"
SUM=$(sha256sum recovery.img | cut -d' ' -f1)
[ "$SUM" = "$(cut -d' ' -f1 recovery.img.sha256)" ] || abort "the recovery inside the zip is corrupted (wrong SHA-256). Download the zip again."
[ "$(head -c 8 recovery.img)" = "ANDROID!" ] || abort "invalid recovery.img"
[ "$(tail -c 16 recovery.img)" = "SEANDROIDENFORCE" ] || abort "recovery.img without SEANDROIDENFORCE"
SIZE=$(wc -c < recovery.img)
PART=$(blockdev --getsize64 $REC 2>/dev/null)
[ -n "$PART" ] && [ "$SIZE" -gt "$PART" ] && abort "image ($SIZE) bigger than the partition ($PART)"
ui_print "- Image verified (SHA-256 OK, $SIZE bytes)"

# 3. flash and read back
ui_print "- Flashing the recovery..."
blockdev --setrw $REC 2>/dev/null
dd if=recovery.img of=$REC bs=1048576 2>/dev/null || abort "writing to the RECOVERY partition failed"
sync
BACK=$(head -c $SIZE $REC | sha256sum | cut -d' ' -f1)
if [ "$BACK" != "$SUM" ]; then
  ui_print " "
  ui_print "ERROR: the check after flashing failed!"
  ui_print "Flash the recovery with Odin (.tar) before rebooting."
  cd /; rm -rf $T; exit 1
fi
ui_print "- Verified after flashing: OK"
cd /; rm -rf $T
ui_print " "
ui_print "Done! Reboot to recovery (Reboot > Recovery)."
ui_print " "
exit 0
