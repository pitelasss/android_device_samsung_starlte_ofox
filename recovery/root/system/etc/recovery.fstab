# AOSP (fs_mgr) fstab - read by init and libbootloader_message, NOT by the recovery UI
# (OrangeFox/TWRP use /system/etc/twrp.fstab + twrp.flags for the partition lists).
# It must stay in pure v2 format: one TWRP-style line makes fs_mgr reject the whole
# file, and then init can't find /misc and refuses "reboot,recovery" (the phone
# boots to system instead of recovery).
#<src>                                              <mnt_point>  <type>  <mnt_flags>                 <fs_mgr_flags>
/dev/block/platform/11120000.ufs/by-name/SYSTEM     /system      erofs   ro                          wait
/dev/block/platform/11120000.ufs/by-name/SYSTEM     /system      ext4    ro                          wait
/dev/block/platform/11120000.ufs/by-name/VENDOR     /vendor      erofs   ro                          wait
/dev/block/platform/11120000.ufs/by-name/VENDOR     /vendor      ext4    ro                          wait
/dev/block/platform/11120000.ufs/by-name/ODM        /odm         erofs   ro                          wait
/dev/block/platform/11120000.ufs/by-name/ODM        /odm         ext4    ro                          wait
/dev/block/platform/11120000.ufs/by-name/USERDATA   /data        f2fs    noatime,nosuid,nodev        wait
/dev/block/platform/11120000.ufs/by-name/USERDATA   /data        ext4    noatime,nosuid,nodev        wait
/dev/block/platform/11120000.ufs/by-name/CACHE      /cache       ext4    noatime,nosuid,nodev        wait
/dev/block/platform/11120000.ufs/by-name/EFS        /efs         ext4    noatime,nosuid,nodev        wait
/dev/block/platform/11120000.ufs/by-name/MISC       /misc        emmc    defaults                    defaults
/dev/block/platform/11120000.ufs/by-name/BOOT       /boot        emmc    defaults                    defaults
/dev/block/platform/11120000.ufs/by-name/RECOVERY   /recovery    emmc    defaults                    defaults
