on fs
    wait /dev/block/platform/11120000.ufs
    symlink /dev/block/platform/11120000.ufs /dev/block/bootdevice

on boot
    start health-hal-2-1

service otg-detect /system/bin/sh /system/bin/otg-detect.sh
    user root
    group root
    seclabel u:r:recovery:s0
    disabled

on boot
    start otg-detect
